---
const steps = [
  {
    num: "01",
    icon: "🔍",
    title: "Descubrimiento",
    description: "Escucho tu proyecto, entiendo tu negocio y defino objetivos claros antes de escribir una sola línea de código."
  },
  {
    num: "02",
    icon: "🎨",
    title: "Diseño",
    description: "Defino la estructura visual, la paleta, las tipografías y la experiencia de usuario adaptada a tu marca."
  },
  {
    num: "03",
    icon: "⚡",
    title: "Desarrollo",
    description: "Código limpio, semántico y optimizado. Cada animación, componente y pantalla construido con atención al detalle."
  },
  {
    num: "04",
    icon: "🚀",
    title: "Lanzamiento",
    description: "Deploy en Vercel, revisión final, ajustes post-lanzamiento y soporte para que todo funcione perfecto."
  }
];
---
<section id="process" class="py-24 px-6 md:px-12 relative overflow-hidden"
         style="background: radial-gradient(ellipse 80% 60% at 50% 0%, rgba(44,4,95,0.18) 0%, transparent 70%), #070410;">
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true"
       style="background-image: linear-gradient(rgba(93,3,140,0.03) 1px, transparent 1px), linear-gradient(90deg, rgba(93,3,140,0.03) 1px, transparent 1px); background-size: 80px 80px;">
  </div>
  <div class="max-w-7xl mx-auto">

    <!-- Header -->
    <div class="mb-14 reveal">
      <p class="font-mono-custom text-xs text-muted uppercase tracking-widest mb-3">// cómo trabajo</p>
      <h2 class="serif-display text-3xl md:text-5xl text-text font-normal">
        El <em class="grad-text not-italic">proceso</em>
      </h2>
    </div>

    <!-- Steps grid -->
    <div class="relative grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-px reveal" style="background:#1a1030;">
      <!-- Connector line (desktop only) -->
      <div
        class="hidden md:block absolute pointer-events-none"
        style="top: 72px; left: 5%; right: 5%; height: 2px; background: linear-gradient(90deg, transparent, #5d038c 15%, #3d1495 40%, #149af2 75%, transparent); opacity: 1; z-index: 1; box-shadow: 0 0 12px rgba(20,154,242,0.6), 0 0 28px rgba(93,3,140,0.3);"
        aria-hidden="true"
      ></div>

      {steps.map((step, i) => (
        <div class="process-step relative p-8 group cursor-default reveal-step" data-delay={i * 120}
             style="background: rgba(13,8,32,0.9); border-bottom: 1px solid rgba(93,3,140,0.15);">
          <!-- Small mono number above the big one -->
          <div class="flex items-center gap-2 mb-1">
            <span class="text-base" aria-hidden="true">{step.icon}</span>
            <p class="font-mono-custom text-xs select-none" style="color:#3d1495;">{step.num}</p>
          </div>
          <!-- Big number -->
          <p
            class="process-num serif-display italic font-normal leading-none mb-4 select-none transition-all duration-300"
            style="font-size: 4rem;"
          >
            {step.num}
          </p>
          <!-- Title -->
          <h3 class="serif-display text-lg font-normal text-text mb-3 transition-all">
            {step.title}
          </h3>
          <!-- Description -->
          <p class="text-sm text-muted leading-relaxed">{step.description}</p>
          <!-- Arrow connector (first 3 steps, desktop only) -->
          {i < 3 && (
            <span
              class="hidden md:block absolute font-mono-custom text-xs select-none"
              style="color:#3d1495; right: -6px; top: 50%; transform: translateY(-50%); z-index: 2;"
              aria-hidden="true"
            >→</span>
          )}
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .process-step {
    transform-style: preserve-3d;
    transition: transform 0.3s ease, background 0.3s ease;
  }
  .process-step:hover {
    transform: translateY(-4px) rotateX(2deg);
    background: rgba(20,10,48,0.95);
    box-shadow: 0 -2px 0 rgba(20,154,242,0.4) inset;
  }
  .process-step:hover .serif-display.italic {
    background: linear-gradient(135deg, #5d038c, #3d1495, #149af2);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .process-num {
    background: linear-gradient(135deg, rgba(93,3,140,0.15), rgba(61,20,149,0.25));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .process-step:hover .process-num {
    background: linear-gradient(135deg, #5d038c, #3d1495, #149af2);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    transition: all 0.4s ease;
  }

  .reveal-step {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }
  .reveal-step.visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  const steps = document.querySelectorAll<HTMLElement>('.reveal-step');
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const el = entry.target as HTMLElement;
        const delay = parseInt(el.dataset.delay ?? '0', 10);
        setTimeout(() => el.classList.add('visible'), delay);
        observer.unobserve(el);
      }
    });
  }, { threshold: 0.15 });
  steps.forEach(step => observer.observe(step));
</script>
