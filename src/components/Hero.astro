---
const stats = [
  { value: "26", title: "proyectos", subtitle: "Completados" },
  { value: "3+", title: "años de experiencia", subtitle: "Desarrollando soluciones" },
  { value: "10+", title: "clientes", subtitle: "Satisfechos" }
];

// Asset seleccionado: captura principal del hero
const projectImage = '/posters/heromedia.PNG';
const projectAlt = 'Vista previa del proyecto S3A Industrial desarrollado por DevCraft';

// Reutilizo el link de WhatsApp existente en el proyecto
const whatsappHref = 'https://wa.me/5492804389134?text=Hola%20Pablo%2C%20vi%20tu%20portfolio%20y%20me%20gustar%C3%ADa%20hablar%20sobre%20un%20proyecto%20%F0%9F%91%8B';
const projectDomain = 'mediadesign.com.ar';
---

<section id="hero" class="relative min-h-[calc(100svh-88px)] flex items-center pt-28 lg:pt-32 pb-14 lg:pb-16 px-6 sm:px-8 lg:px-12 overflow-hidden" style="background: radial-gradient(ellipse 70% 65% at 12% 48%, rgba(44,4,95,0.30) 0%, transparent 65%), radial-gradient(ellipse 55% 55% at 82% 38%, rgba(93,3,140,0.24) 0%, transparent 62%), radial-gradient(ellipse 35% 30% at 72% 95%, rgba(20,154,242,0.12) 0%, transparent 70%), #020106;">

  <div class="absolute inset-0 pointer-events-none" aria-hidden="true" style="background-image: linear-gradient(rgba(20,154,242,0.028) 1px, transparent 1px), linear-gradient(90deg, rgba(20,154,242,0.028) 1px, transparent 1px); background-size:60px 60px;"></div>

  <!-- subtle decorative dots -->
  <div aria-hidden="true" class="pointer-events-none">
    <span class="absolute left-12 top-20 w-1 h-1 rounded-full bg-[rgba(156,40,255,0.12)] blur-sm"></span>
    <span class="absolute right-28 top-36 w-1.5 h-1.5 rounded-full bg-[rgba(20,154,242,0.10)] blur-sm"></span>
    <span class="absolute left-1/2 bottom-32 w-1 h-1 rounded-full bg-[rgba(93,3,140,0.08)] blur-sm"></span>
  </div>

  <div class="relative z-10 w-full max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-[0.95fr_1.15fr] gap-12 lg:gap-14 xl:gap-20 items-center">

    <!-- LEFT: content -->
    <div class="max-w-[620px]">
      <div class="availability-badge mb-4 hero-animated-element inline-flex items-center gap-3" role="status" aria-label="Disponible para nuevos proyectos">
        <span class="relative flex-shrink-0 w-3 h-3 rounded-full" aria-hidden="true">
          <span class="absolute inset-0 rounded-full bg-[#14a0f2]"></span>
          <span class="absolute inset-0 rounded-full opacity-30 blur-sm" style="box-shadow:0 0 8px rgba(20,154,242,0.45);"></span>
        </span>
        <span class="font-mono-custom text-xs uppercase tracking-widest text-[rgba(220,216,235,0.75)]" style="background: rgba(9,7,28,0.36); padding:6px 10px; border-radius:9999px; border:1px solid rgba(117,30,232,0.12);">DISPONIBLE PARA NUEVOS PROYECTOS</span>
      </div>

      <div class="font-mono-custom uppercase tracking-widest text-sm mb-3" style="color:#8b7cff;">PABLO PROBOSTE · DEVCRAFT</div>

      <h1 class="serif-display font-normal leading-[0.98] mb-6 text-[3.25rem] sm:text-6xl lg:text-[4.6rem] xl:text-[5.25rem] tracking-[-0.03em]">
        <span class="block text-text">Creo sitios web</span>
        <span class="block text-text">que <span class="grad-text">generan</span></span>
        <span class="block grad-text">resultados.</span>
      </h1>

      <p class="text-base lg:text-lg leading-relaxed mb-8 max-w-xl" style="color: rgba(220,216,235,0.76);">
        Diseño y desarrollo experiencias digitales rápidas, modernas y enfocadas en resultados que ayudan a negocios y profesionales a crecer en Internet. Desde <strong style="color:#56b9ff;">Trelew, Patagonia</strong>, trabajo con clientes de <strong style="color:#56b9ff;">Argentina y toda Latinoamérica</strong>.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 items-start sm:items-center mb-6">
        <a href="#projects" class="inline-flex items-center justify-center px-6 py-3 rounded-[10px] text-white font-semibold h-14 shadow-[0_10px_30px_rgba(53,73,233,0.12)] transition-transform" style="background: linear-gradient(110deg,#751ee8 0%,#3549e9 52%,#149af2 100%);">
          Ver proyectos reales
          <svg class="ml-3" width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>

        <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center px-6 py-3 rounded-[10px] text-white font-medium h-14 border" style="background: rgba(9,7,28,0.4); border:1px solid rgba(117,30,232,0.18);">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="mr-2"><path d="M21 11.5a9.38 9.38 0 01-1.27 4.62l-.1.17-1.9 3.48a1 1 0 01-1.28.42c-1.75-.72-3.45-1.82-4.91-3.28A9.88 9.88 0 013 12 9.5 9.5 0 0112 2.5 9.38 9.38 0 0121 11.5z" stroke="currentColor" stroke-width="0.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Hablemos por WhatsApp
        </a>
      </div>

      <div class="hero-stats flex items-start gap-6 mt-2 w-full max-w-xl">
        <div>
          <p class="serif-display text-3xl font-semibold grad-text">26</p>
          <p class="text-sm text-white">proyectos</p>
          <p class="text-xs text-muted">Completados</p>
        </div>
        <span class="hidden lg:block h-8 border-l border-[rgba(255,255,255,0.04)]"></span>
        <div>
          <p class="serif-display text-3xl font-semibold grad-text">3+</p>
          <p class="text-sm text-white">años de experiencia</p>
          <p class="text-xs text-muted">Desarrollando soluciones</p>
        </div>
        <span class="hidden lg:block h-8 border-l border-[rgba(255,255,255,0.04)]"></span>
        <div>
          <p class="serif-display text-3xl font-semibold grad-text">10+</p>
          <p class="text-sm text-white">clientes</p>
          <p class="text-xs text-muted">Satisfechos</p>
        </div>
      </div>
    </div>

    <!-- RIGHT: showcase -->
    <div class="flex flex-col items-center lg:items-end">
      <div class="relative w-full flex justify-center lg:justify-end">
        <div aria-hidden="true" class="absolute -inset-x-6 -top-8 lg:-top-12 flex justify-center">
          <div class="w-[520px] h-[260px] rounded-2xl" style="background: radial-gradient(circle at 50% 40%, rgba(117,30,232,0.18), transparent 40%); filter: blur(40px);"></div>
        </div>

        <div class="browser-mockup relative w-full max-w-[720px] rounded-[18px] border overflow-hidden" style="border:1px solid rgba(117,30,232,0.55); box-shadow:0 30px 80px rgba(0,0,0,0.55), 0 0 40px rgba(93,3,140,0.22); background:#05020a;">
          <div class="browser-toolbar h-12 flex items-center justify-between px-4" style="background:linear-gradient(180deg, rgba(0,0,0,0.22), transparent);">
            <div class="flex items-center gap-2" aria-hidden="true">
              <span class="w-2.5 h-2.5 rounded-full bg-[#f25454]"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-[#f5d354]"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-[#61d76b]"></span>
            </div>
            <div class="flex items-center justify-center px-3 py-1 rounded-full bg-[rgba(255,255,255,0.04)] text-xs font-mono-custom text-[rgba(220,216,235,0.9)]" style="backdrop-filter: blur(4px);">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="mr-2"><path d="M12 2v2M12 20v2M4 12H2M22 12h-2" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <span aria-hidden="true">{projectDomain}</span>
            </div>
            <div aria-hidden="true" class="opacity-60">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M4 6h16M4 12h12M4 18h8" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
            </div>
          </div>

          <div class="browser-content w-full h-[420px] md:h-[360px] lg:h-[420px] bg-[#070617]">
            <img src={projectImage} alt={projectAlt} width="1280" height="800" loading="eager" fetchpriority="high" class="w-full h-full object-cover block" />
          </div>
        </div>

        <!-- floating cards -->
        <div class="hidden md:flex absolute right-4 top-6 flex-col items-start p-3 rounded-lg" style="background: rgba(9,7,28,0.88); border:1px solid rgba(117,30,232,0.55); backdrop-filter: blur(8px); box-shadow:0 12px 30px rgba(0,0,0,0.5);">
          <div class="flex items-center gap-2">
            <div class="w-8 h-8 rounded-full flex items-center justify-center bg-[rgba(156,40,255,0.12)]">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 7h18v10H3z" stroke="#9c28ff" stroke-width="1.2" stroke-linejoin="round"/></svg>
            </div>
            <div>
              <p class="text-xl font-semibold text-white">26</p>
              <p class="text-xs text-[rgba(220,216,235,0.7)]">proyectos reales</p>
              <p class="text-[11px] text-muted">Diseñados y desarrollados</p>
            </div>
          </div>
        </div>

        <div class="hidden md:flex absolute right-8 bottom-6 flex-col items-start p-3 rounded-lg" style="background: rgba(6,10,22,0.9); border:1px solid rgba(20,154,242,0.14); backdrop-filter: blur(8px); box-shadow:0 12px 30px rgba(0,0,0,0.45);">
          <div class="flex items-center gap-2">
            <div class="w-8 h-8 rounded-full flex items-center justify-center bg-[rgba(20,154,242,0.08)]">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 4h16v16H4z" stroke="#14a0f2" stroke-width="1.2" stroke-linejoin="round"/></svg>
            </div>
            <div>
              <p class="text-sm font-semibold text-white">Astro · React · Tailwind</p>
              <p class="text-[11px] text-muted">Stack principal</p>
            </div>
          </div>
        </div>

      </div>
    </div>

  </div>
</section>

<!-- Divider -->
<div aria-hidden="true" class="w-full" style="height:2px; background: linear-gradient(90deg, transparent 0%, #5d038c 25%, #149af2 75%, transparent 100%); opacity:0.7; box-shadow:0 0 16px rgba(93,3,140,0.4); margin-top:18px;"></div>

<style>
  .grad-text { background: linear-gradient(90deg,#9c28ff 0%,#6447ff 48%,#149af2 100%); -webkit-background-clip:text; background-clip:text; color:transparent; }
  .grad-text-strong { background: linear-gradient(90deg,#9c28ff 0%,#6447ff 48%,#149af2 100%); -webkit-background-clip:text; background-clip:text; color:transparent; font-weight:700; }

  /* Entrance animations */
  .hero-animated-element { opacity:0; transform:translateY(16px); animation:heroFadeIn 0.64s cubic-bezier(0.22,1,0.36,1) forwards; }
  .hero-animated-element:nth-of-type(1){ animation-delay:0.12s }
  .hero-animated-element:nth-of-type(2){ animation-delay:0.22s }
  .hero-animated-element:nth-of-type(3){ animation-delay:0.32s }
  @keyframes heroFadeIn { to { opacity:1; transform:none; } }

  @media (prefers-reduced-motion: reduce) {
    .hero-animated-element { animation:none !important; transition:none !important; opacity:1 !important; transform:none !important; }
  }

  /* Responsive tweaks */
  @media (max-width:767px){
    h1.serif-display{ font-size: clamp(1.8rem,6vw,3.5rem); }
    .browser-content{ height:260px !important; }
    .hidden.md\:flex{ display:flex !important; }
  }

</style>

<script>
// Minimal mockup tilt (only pointer: fine, respects reduced-motion)
if (window.matchMedia && window.matchMedia('(pointer: fine)').matches && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
  const mockup = document.querySelector('.browser-mockup');
  if (mockup) {
    let frame = null;
    mockup.style.willChange = 'transform';
    function onMove(e){
      const rect = mockup.getBoundingClientRect();
      const cx = rect.left + rect.width/2;
      const cy = rect.top + rect.height/2;
      const dx = (e.clientX - cx)/(rect.width/2);
      const dy = (e.clientY - cy)/(rect.height/2);
      const rotY = dx * 3;
      const rotX = -dy * 3;
      if(frame) cancelAnimationFrame(frame);
      frame = requestAnimationFrame(()=> mockup.style.transform = `perspective(1000px) rotateX(${rotX}deg) rotateY(${rotY}deg)`);
    }
    mockup.addEventListener('mousemove', onMove);
    mockup.addEventListener('mouseleave', ()=>{ mockup.style.transition='transform .6s ease'; mockup.style.transform='perspective(1000px) rotateX(0) rotateY(0)'; });
    mockup.addEventListener('mouseenter', ()=> mockup.style.transition='transform .1s ease');
  }
}
</script>
